# Copy to .env and configure the providers used by your models.

# OpenAI / OpenAI-compatible API (openai/<model>)
# Optional: custom endpoint for a proxy or self-hosted model.
OPENAI_API_BASE=
OPENAI_API_KEY=

# Google Gemini (gemini/<model>)
GEMINI_API_KEY=

# Amazon Bedrock (bedrock/<model>)
# Set your Bedrock API key and the region where the model is available.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION_NAME=

# DeepSeek (deepseek/<model>)
DEEPSEEK_API_KEY=
